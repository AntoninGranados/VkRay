{
    "version": 1,
    "jobs": [
        {
            "scene":   "assets/scenes/room.json",
            "output":  "outputs/render.png",
            "samples": 100000,
            "width":   1280,
            "height":  720,
            "parameters": {
                "pathtracer/sampling/max_bounces": 16,
                
                "pathtracer/sampling/variance_sampling": true,
                "pathtracer/sampling/variance_warmup":   1000,

                "pathtracer/sampling/clip_accumulation": false,
                "pathtracer/sampling/clip_threshold":    800.0
            }
        }
    ]
}
