{
    "version": 1,
    "jobs": [
        {
            "scene":   "assets/scenes/room.json",
            "output":  "outputs/render.png",
            "samples": 100000,
            "width":   1280,
            "height":  720,
            "parameters": {
                "render/max_bounces": 16,
                
                "render/adaptive_sampling": true,
                "render/adaptive_warmup":   1000,

                "render/clamp": false,
                "render/clamp_threshold":    800.0
            }
        }
    ]
}
