{
    "version": 1,
    "jobs": [
        {
            "scene":   "assets/scenes/room.json",
            "output":  "outputs/render.png",
            "samples": 100000,
            "width":   1280,
            "height":  720,
            "parameters": {
                "renderer/sampling/max_bounces": 16,
                
                "renderer/sampling/adaptive_sampling": true,
                "renderer/sampling/adaptive_warmup":   1000,

                "renderer/sampling/clamp": false,
                "renderer/sampling/clamp_threshold":    800.0
            }
        }
    ]
}
