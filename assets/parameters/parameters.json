{
    "pathtracer": {
        "label": "Pathtracer",
        "denoising": { "label": "Denoising", "default": false },
        "debug_view": {
            "label": "Debug View",
            "items": ["None", "Position W", "Position", "Normal W", "Normal", "Albedo", "Roughness", "Mat Type", "Bounces", "Hit Checks", "Variance", "Selection Mask", "Sky Mask"],
            "default": "None",
            "restart_accumulation": true
        },
        "sampling": {
            "label": "Sampling",
            "max_bounces":          { "label": "Max Bounces",          "default": 8,      "min": 1, "max": 20,   "step": 1 },
            "render_samples":       { "label": "Render Samples",       "default": 2048,   "min": 1, "max": 4096, "step": 1 },
            "importance_sampling":  { "label": "Importance Sampling",  "default": true },
            "clip_accumulation":    { "label": "Clip Accumulation",    "default": false,  "restart_accumulation": true },
            "clip_threshold": {
                "label": "Clip Threshold",
                "default": 50.0, "min": 0.0, "max": 1000.0, "step": 0.01,
                "restart_accumulation": true,
                "condition": { "param": "pathtracer/sampling/clip_accumulation", "when": true }
            },
            "variance_sampling":    { "label": "Variance Sampling",    "default": true },
            "variance_warmup": {
                "label": "Variance Warmup Samples",
                "default": 64, "min": 0, "max": 2048, "step": 1,
                "condition": { "param": "pathtracer/sampling/variance_sampling", "when": true }
            }
        },
        "aov": {
            "label": "Arbitrary Output Variables",
            "position_w": { "label": "Position W", "default": false },
            "position":   { "label": "Position",   "default": false },
            "normal_w":   { "label": "Normal W",   "default": false },
            "normal":     { "label": "Normal",     "default": false },
            "albedo":     { "label": "Albedo",     "default": false },
            "roughness":  { "label": "Roughness",  "default": false },
            "mat_type":   { "label": "Mat Type",   "default": false },
            "sky_mask":   { "label": "Sky Mask",   "default": false }
        }
    },
    "scene": {
        "label": "Scene",
        "light_mode": {
            "label": "Light Mode",
            "items": ["Day", "Sunset", "Night", "Empty"],
            "default": "Day",
            "restart_accumulation": true
        }
    }
}
